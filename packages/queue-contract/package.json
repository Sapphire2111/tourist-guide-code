    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tg/shared": "workspace:*",
    "bullmq": "6.5.1"
  },
  "devDependencies": {
    "@tg/config": "workspace:*",
    "@types/node": "22.15.32",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "5.8.3",
    "vitest": "4.1.9"
  }
}
