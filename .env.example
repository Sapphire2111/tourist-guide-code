# Переменные окружения «Гід туриста» — шаблон для local.
# Скопируйте в .env (он в .gitignore) и заполните. Значения секретов в репозиторий НЕ коммитятся:
# для staging/prod они задаются только в Render (Environment) и GitHub Secrets.
# Схемы валидации: apps/{api,worker,bot}/src/config.ts. В local внешние сервисы необязательны;
# при APP_ENV=staging|prod процесс не стартует без обязательных переменных.

# --- Общие ---------------------------------------------------------------
NODE_ENV=development            # development | production | test
APP_ENV=local                   # local | staging | prod
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
# Наблюдаемость (T1-18, docs/adr/0010-observability.md). Логи — JSON в stdout, ПДн маскируются.
# Трекер ошибок: пусто — ошибки только в лог; задан DSN Sentry (https://<key>@<host>/<project>) — ещё и в Sentry.
SENTRY_DSN=
# api GET /metrics (Prometheus): задан — только с Authorization: Bearer <токен>; в prod без него /metrics нет.
METRICS_TOKEN=
# api rate limit (T1-24, ADR-0012): on (по умолчанию; Redis при REDIS_URL) | memory (память процесса, staging) |
# off (только для нагрузочного теста).
RATE_LIMIT=
# api: сколько прокси перед api добавляют X-Forwarded-For. Пусто — 0 в local, 1 в staging/prod (Render).
TRUST_PROXY_HOPS=
# worker: снимок длины очередей в лог, мс (по умолчанию 600000 = 10 мин; 0 — выключено).
QUEUE_METRICS_INTERVAL_MS=
# worker: срок хранения заявок гостиницы, дней (D-49; по умолчанию 90) — затем комната и комментарий обезличиваются.
SERVICE_REQUEST_RETENTION_DAYS=

# --- Порты local (3000 и 5173 заняты на машине разработчика) ---------------
PORT=4300                       # api; на Render задаётся платформой автоматически
MINIAPP_PORT=4301               # vite dev/preview miniapp
ADMIN_PORT=4302                 # vite dev/preview admin
BOT_PORT=4306                   # bot: webhook Telegram (POST /telegram/webhook); не задан — PORT, затем 4306

# --- Публичные адреса ------------------------------------------------------
PUBLIC_API_URL=http://localhost:4300
PUBLIC_MINIAPP_URL=http://localhost:4301
PUBLIC_ADMIN_URL=http://localhost:4302
# Разрешённые Origin для CORS api, через запятую.
CORS_ORIGINS=http://localhost:4301,http://localhost:4302

# --- PostgreSQL + PostGIS ---------------------------------------------------
# local: контейнер из infra/docker-compose.yml (pnpm local:up).
# staging: Neon → проект → Dashboard → Connect → строка БЕЗ пулинга (Connection pooling выкл.), ?sslmode=require.
# Роль приложения (член группы app, без BYPASSRLS — иначе RLS не действует; apps/api/README.md, «Роли БД»).
# local: суперпользователь tg — работает, но RLS к нему не применяется.
# worker читает её же: без неё не ставится очистка ПДн аудита по сроку (T1-13).
DATABASE_URL=postgresql://tg:tg@localhost:4303/tourist_guide
# Роль миграций — владелец схемы; читает только CLI миграций. Не задана — DATABASE_URL.
# staging: Neon, роль neondb_owner, строка БЕЗ пулинга (миграции берут session-level advisory lock,
# через PgBouncer в режиме transaction он не работает).
# DATABASE_MIGRATION_URL=

# --- Redis ------------------------------------------------------------------
# Очередь BullMQ (ADR-0008). Для worker обязателен во всех окружениях, включая local.
# local: контейнер redis из infra/docker-compose.yml (порт хоста 4304; внутри compose — redis://redis:6379).
# staging: Upstash → база → Connect → TCP URL (rediss://...).
REDIS_URL=redis://localhost:4304
# api: запись аналитических событий (T1-25). queue — задача в очередь analytics, в БД пишет worker;
# direct — api пишет в БД сам. Не задана — queue при REDIS_URL, иначе direct.
# staging: direct (на Render free отдельного worker нет — очередь никто бы не разбирал).
# ANALYTICS_SINK=
# api: приём событий фронтенда POST /analytics/events (on/off; off — 404). Не задан — off в prod, on в local/staging:
# эндпоинт без аутентификации (T1-26) и rate limit (T1-24) — включать в prod только после них.
# ANALYTICS_CLIENT_EVENTS=

# --- Сессии api (T1-26, ADR-0009) -------------------------------------------
# Срок жизни сессии, часов (1–720, по умолчанию 24). Токен — Authorization: Bearer, в БД только его sha256.
# AUTH_SESSION_TTL_HOURS=24
# Dev-вход POST /auth/dev/sessions {"userId": "<uuid>"} — сессия без проверки личности (до входа через Telegram).
# Только APP_ENV=local: при staging/prod с true api не стартует. Не задан — выключен.
# Никогда не включать на сервере, доступном по сети (даже с APP_ENV=local): вход под любым пользователем.
# AUTH_DEV_LOGIN=true
# Вход через Telegram POST /auth/telegram (блок 2, ADR-0015): initData проверяется ключом из TELEGRAM_BOT_TOKEN
# (секция Telegram ниже; без него вход отвечает 503). Максимальный возраст initData (auth_date), часов (1–168,
# по умолчанию 24); старше — 401 и RiskFlag.
# TELEGRAM_INIT_DATA_MAX_AGE_HOURS=24

# --- Файловое хранилище (T1-20, docs/adr/0013-media-storage.md) ------------
# Драйвер: local (по умолчанию; файлы на диске + HMAC-ссылки через api, в prod запрещён) | s3 (любое S3-совместимое).
STORAGE_DRIVER=local
# local: каталог файлов (по умолчанию <tmp ОС>/tourist-guide-storage — общий для api и worker на одной машине).
# STORAGE_LOCAL_DIR=
# local: секрет HMAC-подписи ссылок, ≥ 32 символов (`openssl rand -base64 48`). Не задан — случайный на время
# процесса (ссылки не переживают рестарт). Ссылки ведут на PUBLIC_API_URL/storage/objects/…
# STORAGE_SIGNING_SECRET=
# Публичный адрес префикса public/ (CDN): варианты фото отдаются по нему постоянными ссылками. Не задан — подписанные
# ссылки на час. ВНИМАНИЕ: публичный доступ R2 открывает весь бакет, включая private/ (оригиналы с GPS, документы) —
# не включать на основном бакете; только отдельный публичный бакет/правило Cloudflare на /public/* (ADR-0013).
# STORAGE_PUBLIC_BASE_URL=
# api: ресайз фото — queue (задача в worker) | inline (api сам, фоном после подтверждения, по одному). Не задан —
# queue только при APP_ENV=prod, STORAGE_DRIVER=s3 и REDIS_URL, иначе inline.
# worker в prod не стартует без STORAGE_DRIVER=s3 и ключей S3.
# MEDIA_PROCESSING=
# s3: local — S3Mock из docker-compose (принимает любые ключи; STORAGE_DRIVER=s3 вручную);
# staging/prod — рекомендация Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto.
# Нужен CORS бакета: PUT/GET с origin miniapp/admin, заголовок Content-Type.
S3_ENDPOINT=http://localhost:4305
S3_REGION=us-east-1
S3_BUCKET=tourist-guide
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# --- Telegram ---------------------------------------------------------------
# Тестовый бот: @BotFather → /newbot → токен. Секрет webhook — любая случайная строка
# (напр. `openssl rand -hex 32`), передаётся Telegram в setWebhook и сверяется по заголовку.
# Токен читают api, bot и worker (worker — уведомления и напоминания броней; без токена строки outbox — skipped).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# api: имя бота без @ для ссылки печати QR https://t.me/<бот>?startapp=<код> (админка, блок 3, ADR-0018).
# Не задано — GET /admin/qr-points/{id}/print отвечает 409. У бота в @BotFather должен быть Main Mini App.
TELEGRAM_BOT_USERNAME=
# api: ключ HMAC-SHA256 псевдонимов логина и адреса в счётчиках неудачных входов админа (ADR-0018), ≥ 32 байт
# (`openssl rand -base64 48`). Обязателен в staging/prod; в local не задан — ключ разработки.
ADMIN_LOGIN_HMAC_SECRET=
# Публичный https-адрес бота для setWebhook: webhook = <BOT_PUBLIC_URL>/telegram/webhook.
# Нужен только скрипту регистрации `pnpm --filter @tg/bot webhook:set` (вручную, после build);
# в local — туннель (напр. cloudflared/ngrok) на BOT_PORT. Сам бот при старте webhook не регистрирует.
# Bot также использует PUBLIC_MINIAPP_URL (кнопка WebApp, ?startapp=<payload>) и REDIS_URL (очередь
# исходящих сообщений bot-outbox; без Redis в local — очередь в памяти, в staging/prod REDIS_URL обязателен).
BOT_PUBLIC_URL=
# Необязательно: прямая ссылка Mini App https://t.me/<bot>/<app> (short name из BotFather → /newapp).
# Если задана — кнопка ведёт на неё с ?startapp=<payload> (подписанный start_param в initData); иначе —
# web_app-кнопка на PUBLIC_MINIAPP_URL (только https; query не подписан). В staging/prod адреса — только https.
TELEGRAM_MINIAPP_LINK=
# Серверный ключ Google Places API (New). CLI places:import-google и places:enrich — для запросов мимо кэша
# (--cache). api — прокси фото Google в картке місця (GET /places/{id}/google-photos/{n}); не задан — фото Google в
# карточке не показываются. В браузер не отдаётся. Не коммитить.
# Карта Mini App — отдельный браузерный ключ (ограничен по referrer) и Map ID: переменные сборки Vite
# VITE_GOOGLE_MAPS_BROWSER_KEY и VITE_GOOGLE_MAPS_MAP_ID в apps/miniapp/.env.local (не задан ключ — заглушка вместо карты).
GOOGLE_MAPS_API_KEY=
# api: предел запросов к Google Place Photos в сутки (страховка бюджета, адреса фото кэшируются). По умолчанию 300 (худший случай ≈ $65/мес).
GOOGLE_PHOTO_DAILY_LIMIT=
# api: и в месяц (общий счётчик с CLI places:enrich --covers). По умолчанию 1000 — бесплатный объём Google.
GOOGLE_PHOTO_MONTHLY_LIMIT=
# api: погода (модуль weather) — Google Weather API по GOOGLE_MAPS_API_KEY; запросов в сутки и в месяц не больше
# (America/Los_Angeles). Сверх предела и без ключа — бесплатный Open-Meteo. По умолчанию 300 и 5000.
GOOGLE_WEATHER_DAILY_LIMIT=
GOOGLE_WEATHER_MONTHLY_LIMIT=
# Ключ Claude API. CLI places:enrich --ai — ИИ-текст карточки (Message Batches); api — разбор запроса ассистента на
# главной (POST /assistant/query, фича-флаг module.assistant). Не задан — ассистент отвечает 503 (не 500). Не коммитить.
ANTHROPIC_API_KEY=
# api: суточный бюджет ассистента в единицах (запрос к Claude — 1, голос — 2) на всё api; счётчик — в Redis rate
# limit (без Redis — в памяти процесса). По умолчанию 500. Голос — Speech-to-Text по GOOGLE_MAPS_API_KEY (в проекте
# Google включить Cloud Speech-to-Text API).
ASSISTANT_DAILY_LIMIT=
# api: и на пользователя в сутки (те же единицы). По умолчанию 40.
ASSISTANT_USER_DAILY_LIMIT=
