# Шаблон staging (Render + Neon + Upstash). Файл .env.staging в .gitignore; на практике значения
# вводятся в Render → сервис → Environment (переменные с `sync: false` в render.yaml) — не в репозиторий.

NODE_ENV=production
APP_ENV=staging
LOG_LEVEL=info

# Адреса сервисов Render (подставить фактические *.onrender.com).
PUBLIC_API_URL=https://tg-api-staging.onrender.com
PUBLIC_MINIAPP_URL=https://tg-miniapp-staging.onrender.com
PUBLIC_ADMIN_URL=https://tg-admin-staging.onrender.com
CORS_ORIGINS=https://tg-miniapp-staging.onrender.com,https://tg-admin-staging.onrender.com

# Neon → проект → Dashboard → Connect → строка БЕЗ пулинга (Connection pooling выкл.), ?sslmode=require.
# Приложение — логин-роль tg_api (член app, RLS действует; apps/api/README.md, «Роли БД»).
DATABASE_URL=
# Только для CLI миграций (вручную, не в Render): владелец схемы neondb_owner, тот же хост без пулинга.
DATABASE_MIGRATION_URL=
# Сессии api (T1-26): срок по умолчанию 24 ч. AUTH_DEV_LOGIN в staging НЕ задавать (api не стартует).
# AUTH_SESSION_TTL_HOURS=24
# Upstash → Connect → TCP (rediss://default:<пароль>@<хост>:6379).
REDIS_URL=
# События аналитики (T1-25) — сразу в БД из api: отдельного worker на Render free нет, без этой переменной при
# REDIS_URL api ставит задачи в очередь, которую никто не разбирает. render.yaml сам не применяется (Blueprint не
# подключён) — выставить вручную в Render → api → Environment (или через Render API).
ANALYTICS_SINK=direct
# Rate limit (T1-24, ADR-0012): один инстанс — счётчики в памяти, команды Upstash не тратятся.
RATE_LIMIT=memory
# IP клиента из X-Forwarded-For балансировщика Render (1 hop — проверить после деплоя).
TRUST_PROXY_HOPS=1
# Приём событий фронтенда (POST /analytics/events): не задан — on (staging); off — 404. В prod по умолчанию off.
# ANALYTICS_CLIENT_EVENTS=
# Файловое хранилище (T1-20, ADR-0013). Пока без ключей S3 — local: файлы на диске инстанса Render (ЭФЕМЕРНО: пропадают
# при деплое/рестарте/засыпании), ресайз — в процессе api. Секрет подписи ссылок — случайный, ≥ 32 символов
# (`openssl rand -base64 48`), только в Render → api → Environment.
STORAGE_DRIVER=local
MEDIA_PROCESSING=inline
STORAGE_SIGNING_SECRET=
# Позже — Cloudflare R2 (рекомендация): STORAGE_DRIVER=s3, S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
# S3_REGION=auto, ключи R2 API token. Публичный доступ R2 открывает ВЕСЬ бакет (private/ — оригиналы с GPS,
# документы): на основном бакете не включать; STORAGE_PUBLIC_BASE_URL — только отдельный публичный бакет или custom
# domain с правилом Cloudflare на /public/*; иначе оставить пустым (подписанные ссылки).
# STORAGE_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=tourist-guide-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# @BotFather — отдельный тестовый бот (не prod).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# api: имя бота без @ для ссылки печати QR https://t.me/<бот>?startapp=<код> (админка, блок 3, ADR-0018).
# Не задано — GET /admin/qr-points/{id}/print отвечает 409. У бота в @BotFather должен быть Main Mini App.
TELEGRAM_BOT_USERNAME=
# api: ключ HMAC-SHA256 псевдонимов логина и адреса в счётчиках неудачных входов админа (ADR-0018), ≥ 32 байт
# (`openssl rand -base64 48`). Обязателен в staging/prod; в local не задан — ключ разработки.
ADMIN_LOGIN_HMAC_SECRET=
# Серверный ключ Google Places API (New). CLI places:import-google и places:enrich — для запросов мимо кэша
# (--cache). api — прокси фото Google в картке місця (GET /places/{id}/google-photos/{n}); не задан — фото Google в
# карточке не показываются. В браузер не отдаётся. Не коммитить.
GOOGLE_MAPS_API_KEY=
# api: предел запросов к Google Place Photos в сутки (страховка бюджета, адреса фото кэшируются). По умолчанию 300 (худший случай ≈ $65/мес).
GOOGLE_PHOTO_DAILY_LIMIT=
# api: и в месяц (общий счётчик с CLI places:enrich --covers). По умолчанию 1000 — бесплатный объём Google.
GOOGLE_PHOTO_MONTHLY_LIMIT=
# Ключ Claude API. CLI places:enrich --ai — ИИ-текст карточки (Message Batches); api — разбор запроса ассистента на
# главной (POST /assistant/query, фича-флаг module.assistant). Не задан — ассистент отвечает 503 (не 500). Не коммитить.
ANTHROPIC_API_KEY=
# api: предел обращений ассистента к Claude и Google Speech-to-Text в сутки (страховка бюджета). По умолчанию 500.
# Голос ассистента — Speech-to-Text по GOOGLE_MAPS_API_KEY (в проекте Google включить Cloud Speech-to-Text API).
ASSISTANT_DAILY_LIMIT=
