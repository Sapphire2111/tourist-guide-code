{
  "name": "@tg/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "webhook:set": "node --env-file-if-exists=../../.env dist/set-webhook.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@tg/i18n": "workspace:*",
    "@tg/server-config": "workspace:*",
    "bullmq": "6.3.16",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@tg/config": "workspace:*",
    "@types/node": "22.15.32",
    "@vitest/coverage-v8": "4.1.9",
    "concurrently": "9.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
