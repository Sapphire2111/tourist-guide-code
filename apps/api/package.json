{
  "name": "@tg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/scripts",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:load": "node load/run.mjs",
    "openapi": "tsc -p tsconfig.build.json && node dist/scripts/openapi.js",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/db/migrate-cli.js",
    "db:seed": "tsc -p tsconfig.build.json && node dist/seed/seed-cli.js",
    "admin:create": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli/admin-create.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@tg/i18n": "workspace:*",
    "@tg/media": "workspace:*",
    "@tg/queue-contract": "workspace:*",
    "@tg/server-config": "workspace:*",
    "@tg/shared": "workspace:*",
    "bullmq": "6.5.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "@tg/config": "workspace:*",
    "@types/node": "22.15.32",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.9",
    "autocannon": "8.0.0",
    "concurrently": "9.1.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "supertest": "7.3.1",
    "testcontainers": "11.14.0",
    "typescript": "5.8.3",
    "vitest": "4.1.9"
  }
}
